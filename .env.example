# Copy to .env and edit. Generate a token with:  openssl rand -hex 24
HAWKDROP_TOKEN=change-me-to-a-long-random-string

# Public hostname for the Caddy HTTPS profile (DNS must point here, ports 80/443 open).
# For a LAN-only setup see "HTTPS without a public domain" in the README.
HAWKDROP_DOMAIN=hawkdrop.example.com

# HAWKDROP_CHECK_EVERY=6
# HAWKDROP_DEST=IL
# HAWKDROP_PORT=8765
# HAWKDROP_BIND=127.0.0.1     # only expose port 8765 locally (e.g. when Caddy is in front)
# HAWKDROP_BASE_PATH=/hawkdrop  # if your proxy forwards a path prefix without stripping it
# TZ=Asia/Jerusalem
