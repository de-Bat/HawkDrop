# Copy to .env and edit. Generate a token with:  openssl rand -hex 24
HAWKSENSE_TOKEN=change-me-to-a-long-random-string

# Public hostname for the Caddy HTTPS profile (DNS must point here, ports 80/443 open).
# For a LAN-only setup see "HTTPS without a public domain" in the README.
HAWKSENSE_DOMAIN=hawksense.example.com

# HAWKSENSE_CHECK_EVERY=6
# HAWKSENSE_DEST=IL
# HAWKSENSE_PORT=8765
# HAWKSENSE_BIND=127.0.0.1     # only expose port 8765 locally (e.g. when Caddy is in front)
# HAWKSENSE_BASE_PATH=/hawksense  # if your proxy forwards a path prefix without stripping it
# TZ=Asia/Jerusalem
# HAWKSENSE_RULES_EVERY=7       # days between tax/forwarder rule update checks (0 = off)

# Notification secrets (the channels themselves are chosen in the app or with `hawksense notify`).
# Any [notify.<channel>] setting works as HAWKSENSE_<CHANNEL>_<FIELD>.
# HAWKSENSE_TELEGRAM_BOT_TOKEN=123456:ABC...
# HAWKSENSE_TELEGRAM_CHAT_ID=123456789
# HAWKSENSE_WHATSAPP_PHONE=+972501234567
# HAWKSENSE_WHATSAPP_APIKEY=123456          # CallMeBot
# HAWKSENSE_NTFY_TOPIC=hawksense-long-secret-name
# HAWKSENSE_EMAIL_HOST=smtp.gmail.com
# HAWKSENSE_EMAIL_USERNAME=me@gmail.com
# HAWKSENSE_EMAIL_PASSWORD=app-password
# HAWKSENSE_EMAIL_TO=me@gmail.com
# HAWKSENSE_EBAY_CLIENT_ID=...
# HAWKSENSE_EBAY_CLIENT_SECRET=...

# Security
# HAWKSENSE_SECRET_KEY=...                 # key for secrets saved in the app (default: /data/secret.key)
# HAWKSENSE_ALLOW_PRIVATE_FETCH=1          # allow fetching pages on your own network (off by default)
