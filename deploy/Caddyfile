# Caddy obtains and renews a Let's Encrypt certificate for HAWKSENSE_DOMAIN automatically.
{$HAWKSENSE_DOMAIN} {
	encode zstd gzip
	reverse_proxy hawksense:8765
}

# LAN only, no public domain: use Caddy's own CA instead (install its root
# certificate on the iPhone: Settings > General > About > Certificate Trust Settings).
