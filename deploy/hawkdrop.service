# systemd unit for a bare-metal / Raspberry Pi install.
#
#   sudo python3 -m venv /opt/hawkdrop && sudo /opt/hawkdrop/bin/pip install /path/to/HawkDrop
#   sudo cp deploy/hawkdrop.service /etc/systemd/system/
#   echo 'HAWKDROP_TOKEN=...' | sudo tee /etc/hawkdrop.env && sudo chmod 600 /etc/hawkdrop.env
#   sudo systemctl enable --now hawkdrop
#
# Data lives in /var/lib/hawkdrop. Logs: journalctl -u hawkdrop -f
[Unit]
Description=HawkDrop smart price tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=hawkdrop
Environment=HAWKDROP_HOME=/var/lib/hawkdrop
Environment=HAWKDROP_HOST=0.0.0.0
Environment=HAWKDROP_PORT=8765
Environment=HAWKDROP_CHECK_EVERY=6
EnvironmentFile=-/etc/hawkdrop.env
ExecStart=/opt/hawkdrop/bin/hawkdrop serve
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
