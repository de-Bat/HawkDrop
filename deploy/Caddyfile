# Caddy obtains and renews a Let's Encrypt certificate for HAWKDROP_DOMAIN automatically.
{$HAWKDROP_DOMAIN} {
	encode zstd gzip
	reverse_proxy hawkdrop:8765
}

# LAN only, no public domain: use Caddy's own CA instead (install its root
# certificate on the iPhone: Settings > General > About > Certificate Trust Settings).
