# Copy to .env and edit. Generate a token with:  openssl rand -hex 24
HAWKDROP_TOKEN=change-me-to-a-long-random-string

# Public hostname for the Caddy HTTPS profile (DNS must point here, ports 80/443 open).
# For a LAN-only setup see "HTTPS without a public domain" in the README.
HAWKDROP_DOMAIN=hawkdrop.example.com

# HAWKDROP_CHECK_EVERY=6
# HAWKDROP_DEST=IL
# HAWKDROP_PORT=8765
# HAWKDROP_BIND=127.0.0.1     # only expose port 8765 locally (e.g. when Caddy is in front)
# HAWKDROP_BASE_PATH=/hawkdrop  # if your proxy forwards a path prefix without stripping it
# TZ=Asia/Jerusalem
# HAWKDROP_RULES_EVERY=7       # days between tax/forwarder rule update checks (0 = off)

# Notification secrets (the channels themselves are chosen in the app or with `hawkdrop notify`).
# Any [notify.<channel>] setting works as HAWKDROP_<CHANNEL>_<FIELD>.
# HAWKDROP_TELEGRAM_BOT_TOKEN=123456:ABC...
# HAWKDROP_TELEGRAM_CHAT_ID=123456789
# HAWKDROP_WHATSAPP_PHONE=+972501234567
# HAWKDROP_WHATSAPP_APIKEY=123456          # CallMeBot
# HAWKDROP_NTFY_TOPIC=hawkdrop-long-secret-name
# HAWKDROP_EMAIL_HOST=smtp.gmail.com
# HAWKDROP_EMAIL_USERNAME=me@gmail.com
# HAWKDROP_EMAIL_PASSWORD=app-password
# HAWKDROP_EMAIL_TO=me@gmail.com
# HAWKDROP_EBAY_CLIENT_ID=...
# HAWKDROP_EBAY_CLIENT_SECRET=...
